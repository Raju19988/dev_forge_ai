{
  "compilerOptions": {
    "version": true
  },
  "services": {
    "frontend": {
      "root": "../frontend/",
      "framework": "nextjs"
    },
    "backend": {
      "root": "./",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
